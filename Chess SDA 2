:root {
  --bg: #14171d;
  --bg-2: #1d232b;
  --panel: #212933;
  --panel-2: #2a3542;
  --text: #f2f5f8;
  --muted: #a9b4bf;
  --line: #39485c;
  --primary: #4caf50;
  --primary-dark: #2e7d32;
  --accent: #8a5cf6;
  --light-square: #f0d9b5;
  --dark-square: #b58863;
  --selected: #ffd54f;
  --capture: #ff7a7a;
  --premove: #d8b4fe;
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button,
input {
  font: inherit;
}

.topbar {
  height: 72px;
  background: var(--bg-2);
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 22px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.logo-mark {
  font-size: 2rem;
}

.brand h1 {
  font-size: 1.6rem;
  font-weight: 700;
}

.user-bar {
  display: flex;
  align-items: center;
  gap: 12px;
}

.flag {
  font-size: 1.5rem;
}

.user-name {
  color: var(--text);
  font-weight: 600;
}

.fire {
  color: #ffb347;
}

.btn {
  border: none;
  border-radius: 10px;
  padding: 10px 16px;
  cursor: pointer;
  transition: 0.2s ease;
}

.primary-btn {
  background: var(--primary);
  color: white;
}

.primary-btn:hover {
  background: var(--primary-dark);
}

.secondary-btn {
  background: #415163;
  color: white;
}

.ghost-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--line);
}

.page-shell {
  display: grid;
  grid-template-columns: 220px 1fr 420px;
  min-height: calc(100vh - 72px);
}

.sidebar {
  background: var(--panel);
  border-right: 1px solid var(--line);
  padding: 20px 14px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.nav-btn {
  background: transparent;
  color: var(--text);
  border: 1px solid transparent;
  text-align: left;
  padding: 12px 14px;
  border-radius: 10px;
  cursor: pointer;
}

.nav-btn.active {
  background: var(--panel-2);
  border-color: var(--line);
}

.content {
  padding: 24px;
  overflow: auto;
}

.panel {
  display: none;
}

.panel.active {
  display: block;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 18px;
  box-shadow: 0 8px 18px rgba(0,0,0,0.18);
}

.stat-card {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.label {
  color: var(--muted);
  font-size: 0.85rem;
}

.value {
  font-size: 2.2rem;
}

.chart-card {
  margin-bottom: 20px;
}

.quick-play {
  display: grid;
  grid-template-columns: repeat(3, minmax(200px, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.quick-play h3 {
  margin-bottom: 10px;
}

.online-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(240px, 1fr));
  gap: 16px;
}

.mini-card {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-height: 180px;
}

.mini-card input {
  background: var(--bg);
  color: var(--text);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px;
}

.game-code-box {
  margin-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.hidden {
  display: none;
}

.bot-settings {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 18px 0;
}

.color-options {
  display: flex;
  justify-content: space-between;
  margin: 18px 0;
  flex-wrap: wrap;
  gap: 10px;
}

.top-bots {
  display: grid;
  grid-template-columns: repeat(2, minmax(180px, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.bot-item {
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.opening-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(220px, 1fr));
  gap: 16px;
  margin-top: 18px;
}

.opening-item {
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.friend-search {
  display: flex;
  gap: 10px;
  margin: 18px 0;
}

.friend-search input {
  flex: 1;
  background: var(--bg);
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 12px;
  color: var(--text);
}

.friend-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.friend-item {
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px 14px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.board-panel {
  background: var(--panel);
  border-left: 1px solid var(--line);
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.chessboard {
  width: 100%;
  max-width: 440px;
  aspect-ratio: 1;
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  grid-template-rows: repeat(8, 1fr);
  border: 2px solid var(--line);
  border-radius: 10px;
  overflow: hidden;
}

.square {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: clamp(2rem, 3vw, 3.2rem);
  cursor: pointer;
  user-select: none;
}

.square.light {
  background: var(--light-square);
}

.square.dark {
  background: var(--dark-square);
}

.square.selected {
  box-shadow: inset 0 0 0 4px var(--selected);
}

.square.last-move {
  box-shadow: inset 0 0 0 4px #7dd3fc;
}

.square.premove {
  background-color: var(--premove);
}

.clocks {
  width: 100%;
  max-width: 440px;
  display: flex;
  justify-content: space-between;
  margin-top: 18px;
  gap: 12px;
}

.clock {
  flex: 1;
  background: var(--bg-2);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
  text-align: center;
  font-weight: 700;
  font-size: 1.1rem;
}

@media (max-width: 900px) {
  .page-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    border-right: none;
    border-bottom: 1px solid var(--line);
  }

  .stats-grid,
  .quick-play,
  .opening-list,
  .online-grid {
    grid-template-columns: 1fr;
  }
}
